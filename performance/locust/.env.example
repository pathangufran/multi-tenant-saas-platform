# Authentication
AUTH_BASE_URL=http://localhost:8000
AUTH_LOGIN_PATH=/api/v1/auth/login/
AUTH_USERNAME=loadtest@example.com
AUTH_PASSWORD=replace-with-test-password

# Service base URLs
TENANT_BASE_URL=http://localhost:8001
CORE_BASE_URL=http://localhost:8002
NOTIFICATION_BASE_URL=http://localhost:8003
BILLING_BASE_URL=http://localhost:8004

# Authentication token field
ACCESS_TOKEN_FIELD=access
REFRESH_TOKEN_FIELD=refresh

# Endpoint paths
# Replace these with paths from your actual urls.py files.

AUTH_REFRESH_PATH=/api/v1/auth/token/refresh/

TENANT_LIST_PATH=/api/v1/tenants/list/
TENANT_DETAIL_PATH=/api/v1/tenants/<str:tenant_id>/details/

CORE_PROJECT_LIST_PATH=/api/v1/projects/list/
CORE_TASK_LIST_PATH=/api/v1/tasks/list/
CORE_TASK_CREATE_PATH=/api/v1/tasks/create/
CORE_TASK_UPDATE_PATH=/api/v1/tasks/update/
CORE_TEAM_LIST_PATH=/api/v1/team/list/
CORE_COMMENT_LIST_PATH=/api/v1/comments/list/

BILLING_PLAN_LIST_PATH=/api/v1/plans/
BILLING_SUBSCRIPTION_LIST_PATH=/api/v1/admin/subscriptions/
BILLING_INVOICE_LIST_PATH=/api/v1/admin/invoices/

NOTIFICATION_LIST_PATH=/api/v1/notifications/list/
NOTIFICATION_UNREAD_COUNT_PATH=/api/v1/notifications/mark/read/
NOTIFICATION_MARK_READ_PATH=/api/v1/notifications/mark/unread/

# Workload settings
MIN_WAIT_SECONDS=1
MAX_WAIT_SECONDS=3
REQUEST_TIMEOUT=10
